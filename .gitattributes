# Source PDFs live in Git LFS
data/docs/**/*.pdf filter=lfs diff=lfs merge=lfs -text

# DocTags traces: plain text, but single huge lines — collapse them in GitHub diffs
# and never rewrite line endings
data/traces/*.dt text eol=lf linguist-generated=true -diff

# Lockfile: keep as-is, collapse in review
uv.lock text eol=lf linguist-generated=true

# Notebooks: treat as text, union-merge is unsafe so let conflicts surface
*.ipynb text eol=lf
